<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#171B22"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textColor="#EAEAF2"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/welcome_subtitle"
            android:textColor="#A9B2C0"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/companyEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="#1F2733"
            android:hint="@string/company_hint"
            android:padding="12dp"
            android:text="Padaria Lobo"
            android:textColor="#EAEAF2"
            android:textColorHint="#A9B2C0" />

        <EditText
            android:id="@+id/usernameEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="#1F2733"
            android:hint="@string/username_hint"
            android:padding="12dp"
            android:text="lobo"
            android:textColor="#EAEAF2"
            android:textColorHint="#A9B2C0" />

        <EditText
            android:id="@+id/passwordEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="#1F2733"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:text="lobopt260"
            android:textColor="#EAEAF2"
            android:textColorHint="#A9B2C0" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#4FC3F7"
            android:text="@string/login"
            android:textColor="#101418"
            android:textStyle="bold" />

        <Button
            android:id="@+id/googleButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#202A35"
            android:text="@string/google_login"
            android:textColor="#EAEAF2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#171B22"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title"
            android:textColor="#EAEAF2"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/companyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Padaria Lobo"
            android:textColor="#81C784"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/status_ready"
            android:textColor="#A9B2C0"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/catalogButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#4FC3F7"
                android:text="@string/open_catalog"
                android:textColor="#101418"
                android:textStyle="bold" />

            <Button
                android:id="@+id/labelButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#81C784"
                android:text="@string/new_label"
                android:textColor="#101418"
                android:textStyle="bold" />

            <Button
                android:id="@+id/historyButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="#202A35"
                android:text="@string/history_label"
                android:textColor="#EAEAF2"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
